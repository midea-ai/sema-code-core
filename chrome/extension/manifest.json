{
  "manifest_version": 3,
  "name": "Sema Browser Control",
  "version": "0.5.0",
  "description": "让装在你自己电脑上的桌面助手在你的 Chrome 里打开、阅读和操作网页。",
  "minimum_chrome_version": "116",
  "key": "",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["tabs", "tabGroups", "scripting", "storage", "nativeMessaging", "webNavigation"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Sema 浏览器控制",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  }
}
