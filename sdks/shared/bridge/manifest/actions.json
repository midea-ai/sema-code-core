{
  "description": "桥协议契约单一来源：action 清单（名 = core 方法名）、payload 字段、ack 形态、事件清单。由 scripts/check-consistency.mjs 与 server.ts 路由表、各语言 SDK 镜像方法三方比对防漂移。",
  "protocolVersion": 1,
  "ackKinds": {
    "value": "ack 携带 core 方法的原始返回值（JSON）",
    "delivery": "ack 无数据，仅送达确认（对应 core 无返回值方法）"
  },
  "actions": {
    "init": { "level": "core", "payload": ["<SemaCore 构造配置透传>"], "ack": "value", "note": "ack {ready, protocolVersion}；幂等，不覆盖已有实例" },
    "updateCoreConfig": { "level": "core", "payload": ["<配置对象透传>"], "ack": "delivery" },
    "updateCoreConfByKey": { "level": "core", "payload": ["key", "value"], "ack": "delivery" },
    "addModel": { "level": "core", "payload": ["config", "skipValidation"], "ack": "value", "note": "并广播 model:update" },
    "delModel": { "level": "core", "payload": ["modelName"], "ack": "value", "note": "并广播 model:update" },
    "switchModel": { "level": "core", "payload": ["modelName"], "ack": "value", "note": "并广播 model:update" },
    "applyTaskModel": { "level": "core", "payload": ["main", "quick"], "ack": "value", "note": "并广播 model:update" },
    "getModelData": { "level": "core", "payload": [], "ack": "value" },
    "fetchAvailableModels": { "level": "core", "payload": ["<参数对象透传>"], "ack": "value" },
    "testApiConnection": { "level": "core", "payload": ["<参数对象透传>"], "ack": "value" },
    "getModelAdapter": { "level": "core", "payload": ["provider", "modelName", "baseURL"], "ack": "value" },
    "listSessions": { "level": "core", "payload": [], "ack": "value", "note": "ack {sessions}" },
    "setActiveSession": { "level": "core", "payload": ["sessionId"], "ack": "value", "note": "ack {ok}" },
    "createSession": { "level": "core", "payload": ["sessionId", "permissionLevel", "mode"], "ack": "value", "note": "ack {sessionId}；创建期事件缓存重放" },
    "closeSession": { "level": "core", "payload": ["sessionId"], "ack": "delivery" },
    "getToolInfos": { "level": "core", "payload": [], "ack": "value" },
    "updateDisabledTools": { "level": "core", "payload": ["disabledTools"], "ack": "delivery" },
    "getMarketplacePluginsInfo": { "level": "core", "payload": [], "ack": "value" },
    "refreshMarketplacePluginsInfo": { "level": "core", "payload": [], "ack": "value" },
    "addMarketplaceFromGit": { "level": "core", "payload": ["repo"], "ack": "value" },
    "addMarketplaceFromDirectory": { "level": "core", "payload": ["dirPath"], "ack": "value" },
    "updateMarketplace": { "level": "core", "payload": ["marketplaceName"], "ack": "value" },
    "removeMarketplace": { "level": "core", "payload": ["marketplaceName"], "ack": "value" },
    "installPlugin": { "level": "core", "payload": ["pluginName", "marketplaceName", "scope", "projectPath"], "ack": "value" },
    "uninstallPlugin": { "level": "core", "payload": ["pluginName", "marketplaceName", "scope", "projectPath"], "ack": "value" },
    "enablePlugin": { "level": "core", "payload": ["pluginName", "marketplaceName", "scope", "projectPath"], "ack": "value" },
    "disablePlugin": { "level": "core", "payload": ["pluginName", "marketplaceName", "scope", "projectPath"], "ack": "value" },
    "updatePlugin": { "level": "core", "payload": ["pluginName", "marketplaceName", "scope", "projectPath"], "ack": "value" },
    "getAgentsInfo": { "level": "core", "payload": ["concise", "refresh"], "ack": "value" },
    "addAgentConf": { "level": "core", "payload": ["<agent 配置对象透传>"], "ack": "value" },
    "removeAgentConf": { "level": "core", "payload": ["name"], "ack": "value" },
    "getSkillsInfo": { "level": "core", "payload": ["concise", "refresh"], "ack": "value" },
    "removeSkillConf": { "level": "core", "payload": ["name"], "ack": "value" },
    "getCommandsInfo": { "level": "core", "payload": ["concise", "refresh"], "ack": "value" },
    "addCommandConf": { "level": "core", "payload": ["<command 配置对象透传>"], "ack": "value" },
    "removeCommandConf": { "level": "core", "payload": ["name"], "ack": "value" },
    "getMCPServerInfo": { "level": "core", "payload": [], "ack": "value" },
    "refreshMCPServerInfo": { "level": "core", "payload": [], "ack": "value" },
    "addMCPServer": { "level": "core", "payload": ["<MCP 配置对象透传>"], "ack": "value" },
    "removeMCPServer": { "level": "core", "payload": ["name"], "ack": "value" },
    "reconnectMCPServer": { "level": "core", "payload": ["name"], "ack": "value" },
    "disableMCPServer": { "level": "core", "payload": ["name"], "ack": "value" },
    "enableMCPServer": { "level": "core", "payload": ["name"], "ack": "value" },
    "updateMCPUseTools": { "level": "core", "payload": ["name", "toolNames"], "ack": "value" },
    "getCronTasks": { "level": "core", "payload": [], "ack": "value" },
    "deleteCronTask": { "level": "core", "payload": ["id"], "ack": "value" },
    "enableCronTask": { "level": "core", "payload": ["id"], "ack": "value" },
    "disableCronTask": { "level": "core", "payload": ["id"], "ack": "value" },
    "getMemoryInfo": { "level": "core", "payload": ["refresh"], "ack": "value" },
    "getRuleInfo": { "level": "core", "payload": ["refresh"], "ack": "value" },
    "getHooksInfo": { "level": "core", "payload": ["refresh"], "ack": "value" },
    "getDesignSkillsInfo": { "level": "core", "payload": ["refresh"], "ack": "value" },
    "getDesignSystemsInfo": { "level": "core", "payload": ["refresh"], "ack": "value" },

    "processUserInput": { "level": "session", "payload": ["content", "orgContent", "attachments"], "ack": "delivery" },
    "interrupt": { "level": "session", "payload": [], "ack": "delivery" },
    "respondToToolPermission": { "level": "session", "payload": ["toolId", "toolName", "selected"], "ack": "delivery" },
    "respondToPickOption": { "level": "session", "payload": ["<应答对象透传>"], "ack": "delivery" },
    "respondToPlanExit": { "level": "session", "payload": ["<应答对象透传>"], "ack": "delivery" },
    "updateAgentMode": { "level": "session", "payload": ["mode"], "ack": "delivery" },
    "updatePermissionLevel": { "level": "session", "payload": ["level"], "ack": "delivery" },
    "getForkPreview": { "level": "session", "payload": ["messageUuid"], "ack": "value" },
    "fork": { "level": "session", "payload": ["messageUuid", "options"], "ack": "value" },
    "stopAllTasks": { "level": "session", "payload": [], "ack": "value" },
    "transferAgentToBackground": { "level": "session", "payload": ["taskId"], "ack": "value" },
    "transferAllForegroundAgents": { "level": "session", "payload": [], "ack": "value" },
    "getTaskList": { "level": "session", "payload": [], "ack": "value" },
    "stopTask": { "level": "session", "payload": ["taskId"], "ack": "value" },
    "watchTask": { "level": "session", "payload": ["taskId"], "ack": "value", "note": "增量以会话级合成事件 task:watch:delta 上行" },
    "unwatchTask": { "level": "session", "payload": ["taskId"], "ack": "value" }
  },
  "events": {
    "session": [
      "session:ready", "session:error", "session:interrupted", "session:cleared",
      "state:update",
      "input:received", "input:processing",
      "message:text:chunk", "message:thinking:chunk", "message:complete",
      "tool:permission:request", "tool:permission:auto",
      "tool:execution:complete", "tool:execution:chunk", "tool:execution:error",
      "task:agent:start", "task:agent:end", "task:start", "task:end", "task:transfer",
      "todos:update", "topic:update",
      "pick:option:request", "plan:exit:request", "plan:implement",
      "compact:exec",
      "conversation:usage", "file:reference",
      "permissionLevel:update", "quickchat:response",
      "hook:notice"
    ],
    "process": ["cron:update", "mcp:server:status"],
    "synthetic": {
      "model:update": "模型变更四连的跨连接广播（进程级帧）",
      "task:watch:delta": "watchTask 的增量输出（会话级帧）"
    }
  }
}
