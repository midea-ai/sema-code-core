{
  "name": "sema-code-ui",
  "version": "2.1.4",
  "description": "SemaWork 命令行启动器：sema-ui 一条命令在浏览器打开基于 sema-core 的本地 Web 界面",
  "author": "AIRC Sema Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/midea-ai/sema-code-core.git",
    "directory": "webui/cli"
  },
  "bin": {
    "sema-ui": "bin/sema-ui.js"
  },
  "files": [
    "bin",
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20.18.1"
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "sema",
    "ai",
    "assistant",
    "webui",
    "cli"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.25.1",
    "cron-parser": "^5.5.0",
    "diff": "7.0.0",
    "node-pty": "^1.1.0",
    "sema-core": "^2.1.4",
    "ws": "^8.18.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/diff": "^7.0.2",
    "@types/node": "^20.0.0",
    "@types/ws": "^8.5.12",
    "esbuild": "^0.24.0",
    "typescript": "^5.4.0"
  }
}
